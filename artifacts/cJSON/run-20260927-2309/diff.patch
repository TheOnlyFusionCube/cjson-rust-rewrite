new file mode 100644
index 0000000..852f79b
--- /dev/null
+++ b/src/parse.rs
@@ -0,0 +1,473 @@
+use std::cell::Cell;
+
+use crate::number::{parse_strtod, value_int};
+use crate::value::{Json, Value, NESTING_LIMIT};
+
+thread_local! {
+    static ERROR_OFFSET: Cell<Option<usize>> = const { Cell::new(None) };
+}
+
+pub struct Parsed {
+    pub item: Option<Json>,
+    pub end: usize,
+}
+
+struct Buf<'a> {
+    content: &'a [u8],
+    length: usize,
+    offset: usize,
+    depth: usize,
+}
+
+impl<'a> Buf<'a> {
+    fn can_read(&self, size: usize) -> bool {
+        self.offset
+            .checked_add(size)
+            .is_some_and(|end| end <= self.length)
+    }
+
+    fn can_access(&self, index: usize) -> bool {
+        self.offset
+            .checked_add(index)
+            .is_some_and(|pos| pos < self.length)
+    }
+
+    fn at(&self, index: usize) -> u8 {
+        let Some(pos) = self.offset.checked_add(index) else {
+            return 0;
+        };
+        if pos < self.length && pos < self.content.len() {
+            self.content[pos]
+        } else {
+            0
+        }
+    }
+
+    fn abs(&self, pos: usize) -> u8 {
+        if pos < self.length && pos < self.content.len() {
+            self.content[pos]
+        } else {
+            0
+        }
+    }
+}
+
+fn set_error(offset: Option<usize>) {
+    ERROR_OFFSET.with(|slot| slot.set(offset));
+}
+
+pub fn get_error_ptr() -> Option<usize> {
+    ERROR_OFFSET.with(|slot| slot.get())
+}
+
+pub fn parse(value: &str) -> Option<Json> {
+    parse_with_opts(value, false).item
+}
+
+pub fn parse_with_length(value: &[u8], buffer_length: usize) -> Option<Json> {
+    parse_with_length_opts(value, buffer_length, false).item
+}
+
+pub fn parse_with_opts(value: &str, require_null_terminated: bool) -> Parsed {
+    parse_with_length_opts(value.as_bytes(), value.len() + 1, require_null_terminated)
+}
+
+pub fn parse_with_length_opts(
+    value: &[u8],
+    buffer_length: usize,
+    require_null_terminated: bool,
+) -> Parsed {
+    set_error(None);
+    if buffer_length == 0 {
+        set_error(Some(0));
+        return Parsed { item: None, end: 0 };
+    }
+    let length = buffer_length.min(value.len().saturating_add(1));
+    let mut buf = Buf {
+        content: value,
+        length,
+        offset: 0,
+        depth: 0,
+    };
+    skip_bom(&mut buf);
+    skip_ws(&mut buf);
+    match parse_value(&mut buf) {
+        Some(item) => {
+            if require_null_terminated {
+                skip_ws(&mut buf);
+                if buf.offset >= buf.length || buf.at(0) != 0 {
+                    let pos = error_pos(&buf);
+                    set_error(Some(pos));
+                    return Parsed {
+                        item: None,
+                        end: pos,
+                    };
+                }
+            }
+            Parsed {
+                item: Some(item),
+                end: buf.offset,
+            }
+        }
+        None => {
+            let pos = error_pos(&buf);
+            set_error(Some(pos));
+            Parsed {
+                item: None,
+                end: pos,
+            }
+        }
+    }
+}
+
+fn error_pos(buf: &Buf) -> usize {
+    if buf.offset < buf.length {
+        buf.offset
+    } else if buf.length > 0 {
+        buf.length - 1
+    } else {
+        0
+    }
+}
+
+fn skip_bom(buf: &mut Buf) {
+    if buf.offset != 0 {
+        return;
+    }
+    if buf.can_access(4) && buf.at(0) == 0xEF && buf.at(1) == 0xBB && buf.at(2) == 0xBF {
+        buf.offset += 3;
+    }
+}
+
+fn skip_ws(buf: &mut Buf) {
+    if !buf.can_access(0) {
+        return;
+    }
+    while buf.can_access(0) && buf.at(0) <= 32 {
+        buf.offset += 1;
+    }
+    if buf.offset == buf.length && buf.offset > 0 {
+        buf.offset -= 1;
+    }
+}
+
+fn parse_value(buf: &mut Buf) -> Option<Json> {
+    if buf.starts_with(b"null") {
+        buf.offset += 4;
+        return Some(node(Value::Null));
+    }
+    if buf.starts_with(b"false") {
+        buf.offset += 5;
+        return Some(node(Value::Bool(false)));
+    }
+    if buf.starts_with(b"true") {
+        buf.offset += 4;
+        return Some(node(Value::Bool(true)));
+    }
+    if buf.can_access(0) && buf.at(0) == b'"' {
+        let text = parse_string(buf)?;
+        return Some(node(Value::String(text)));
+    }
+    if buf.can_access(0) && (buf.at(0) == b'-' || buf.at(0).is_ascii_digit()) {
+        return parse_number(buf);
+    }
+    if buf.can_access(0) && buf.at(0) == b'[' {
+        let items = parse_array(buf)?;
+        return Some(node(Value::Array(items)));
+    }
+    if buf.can_access(0) && buf.at(0) == b'{' {
+        let items = parse_object(buf)?;
+        return Some(node(Value::Object(items)));
+    }
+    None
+}
+
+impl<'a> Buf<'a> {
+    fn starts_with(&self, literal: &[u8]) -> bool {
+        if !self.can_read(literal.len()) {
+            return false;
+        }
+        literal
+            .iter()
+            .enumerate()
+            .all(|(index, byte)| self.at(index) == *byte)
+    }
+}
+
+fn node(value: Value) -> Json {
+    Json {
+        value,
+        key: None,
+        reference: false,
+    }
+}
+
+fn parse_number(buf: &mut Buf) -> Option<Json> {
+    let mut length = 0usize;
+    while buf.can_access(length) {
+        match buf.at(length) {
+            b'0'..=b'9' | b'+' | b'-' | b'e' | b'E' | b'.' => length += 1,
+            _ => break,
+        }
+    }
+    let start = buf.offset;
+    let end = start + length;
+    let slice_end = end.min(buf.content.len());
+    let text = if start < buf.content.len() {
+        &buf.content[start..slice_end]
+    } else {
+        b""
+    };
+    let (number, consumed) = parse_strtod(text)?;
+    if consumed == 0 {
+        return None;
+    }
+    buf.offset += consumed;
+    Some(node(Value::Number {
+        valuedouble: number,
+        valueint: value_int(number),
+    }))
+}
+
+fn parse_string(buf: &mut Buf) -> Option<String> {
+    if !buf.can_access(0) || buf.at(0) != b'"' {
+        return None;
+    }
+    let mut cursor = buf.offset + 1;
+    while cursor < buf.length && buf.abs(cursor) != b'"' {
+        if buf.abs(cursor) == b'\\' {
+            if cursor + 1 >= buf.length {
+                buf.offset = cursor;
+                return None;
+            }
+            cursor += 1;
+        }
+        cursor += 1;
+    }
+    if cursor >= buf.length || buf.abs(cursor) != b'"' {
+        buf.offset = cursor.min(buf.length.saturating_sub(1));
+        return None;
+    }
+    let quote = cursor;
+    let mut raw = Vec::new();
+    let mut index = buf.offset + 1;
+    while index < quote {
+        if buf.abs(index) != b'\\' {
+            raw.push(buf.abs(index));
+            index += 1;
+            continue;
+        }
+        if quote - index < 1 {
+            buf.offset = index;
+            return None;
+        }
+        let next = buf.abs(index + 1);
+        match next {
+            b'b' => raw.push(8),
+            b'f' => raw.push(12),
+            b'n' => raw.push(b'\n'),
+            b'r' => raw.push(b'\r'),
+            b't' => raw.push(b'\t'),
+            b'"' | b'\\' | b'/' => raw.push(next),
+            b'u' => {
+                let available = &window(buf, index, quote);
+                let (sequence, bytes) = utf16_literal_to_utf8(available)?;
+                raw.extend_from_slice(&bytes);
+                index += sequence;
+                continue;
+            }
+            _ => {
+                buf.offset = index;
+                return None;
+            }
+        }
+        index += 2;
+    }
+    buf.offset = quote + 1;
+    Some(bytes_to_string(raw))
+}
+
+fn window(buf: &Buf, start: usize, end: usize) -> Vec<u8> {
+    let mut out = Vec::new();
+    let mut index = start;
+    while index < end {
+        out.push(buf.abs(index));
+        index += 1;
+    }
+    out
+}
+
+fn bytes_to_string(bytes: Vec<u8>) -> String {
+    String::from_utf8(bytes)
+        .unwrap_or_else(|err| String::from_utf8_lossy(err.as_bytes()).into_owned())
+}
+
+fn utf16_literal_to_utf8(input: &[u8]) -> Option<(usize, Vec<u8>)> {
+    if input.len() < 6 {
+        return None;
+    }
+    let first_code = parse_hex4(&input[2..6])?;
+    if (0xDC00..=0xDFFF).contains(&first_code) {
+        return None;
+    }
+    let (sequence_length, codepoint) = if (0xD800..=0xDBFF).contains(&first_code) {
+        if input.len() < 12 || input[6] != b'\\' || input[7] != b'u' {
+            return None;
+        }
+        let second_code = parse_hex4(&input[8..12])?;
+        if !(0xDC00..=0xDFFF).contains(&second_code) {
+            return None;
+        }
+        let point = 0x10000 + (((first_code & 0x3FF) << 10) | (second_code & 0x3FF));
+        (12usize, point)
+    } else {
+        (6usize, first_code)
+    };
+    Some((sequence_length, encode_utf8(codepoint)?))
+}
+
+fn parse_hex4(input: &[u8]) -> Option<u32> {
+    if input.len() < 4 {
+        return None;
+    }
+    let mut value = 0u32;
+    for (index, byte) in input.iter().copied().take(4).enumerate() {
+        let digit = match byte {
+            b'0'..=b'9' => byte - b'0',
+            b'A'..=b'F' => byte - b'A' + 10,
+            b'a'..=b'f' => byte - b'a' + 10,
+            _ => return Some(0),
+        };
+        value += u32::from(digit);
+        if index < 3 {
+            value <<= 4;
+        }
+    }
+    Some(value)
+}
+
+fn encode_utf8(mut codepoint: u32) -> Option<Vec<u8>> {
+    let (length, first_mark) = if codepoint < 0x80 {
+        (1usize, 0u32)
+    } else if codepoint < 0x800 {
+        (2, 0xC0)
+    } else if codepoint < 0x10000 {
+        (3, 0xE0)
+    } else if codepoint <= 0x10FFFF {
+        (4, 0xF0)
+    } else {
+        return None;
+    };
+    let mut out = vec![0u8; length];
+    for position in (1..length).rev() {
+        out[position] = ((codepoint | 0x80) & 0xBF) as u8;
+        codepoint >>= 6;
+    }
+    out[0] = if length > 1 {
+        ((codepoint | first_mark) & 0xFF) as u8
+    } else {
+        (codepoint & 0x7F) as u8
+    };
+    Some(out)
+}
+
+fn parse_array(buf: &mut Buf) -> Option<Vec<Json>> {
+    if buf.depth >= NESTING_LIMIT {
+        return None;
+    }
+    buf.depth += 1;
+    if !buf.can_access(0) || buf.at(0) != b'[' {
+        return None;
+    }
+    buf.offset += 1;
+    skip_ws(buf);
+    if buf.can_access(0) && buf.at(0) == b']' {
+        buf.depth -= 1;
+        buf.offset += 1;
+        return Some(Vec::new());
+    }
+    if !buf.can_access(0) {
+        if buf.offset > 0 {
+            buf.offset -= 1;
+        }
+        return None;
+    }
+    if buf.offset == 0 {
+        return None;
+    }
+    buf.offset -= 1;
+    let mut items = Vec::new();
+    loop {
+        buf.offset += 1;
+        skip_ws(buf);
+        items.push(parse_value(buf)?);
+        skip_ws(buf);
+        if !(buf.can_access(0) && buf.at(0) == b',') {
+            break;
+        }
+    }
+    if !buf.can_access(0) || buf.at(0) != b']' {
+        return None;
+    }
+    buf.depth -= 1;
+    buf.offset += 1;
+    Some(items)
+}
+
+fn parse_object(buf: &mut Buf) -> Option<Vec<Json>> {
+    if buf.depth >= NESTING_LIMIT {
+        return None;
+    }
+    buf.depth += 1;
+    if !buf.can_access(0) || buf.at(0) != b'{' {
+        return None;
+    }
+    buf.offset += 1;
+    skip_ws(buf);
+    if buf.can_access(0) && buf.at(0) == b'}' {
+        buf.depth -= 1;
+        buf.offset += 1;
+        return Some(Vec::new());
+    }
+    if !buf.can_access(0) {
+        if buf.offset > 0 {
+            buf.offset -= 1;
+        }
+        return None;
+    }
+    if buf.offset == 0 {
+        return None;
+    }
+    buf.offset -= 1;
+    let mut items = Vec::new();
+    loop {
+        if !buf.can_access(1) {
+            return None;
+        }
+        buf.offset += 1;
+        skip_ws(buf);
+        let name = parse_string(buf)?;
+        skip_ws(buf);
+        if !buf.can_access(0) || buf.at(0) != b':' {
+            return None;
+        }
+        buf.offset += 1;
+        skip_ws(buf);
+        let mut child = parse_value(buf)?;
+        child.key = Some(crate::value::Key {
+            name,
+            constant: false,
+        });
+        items.push(child);
+        skip_ws(buf);
+        if !(buf.can_access(0) && buf.at(0) == b',') {
+            break;
+        }
+    }
+    if !buf.can_access(0) || buf.at(0) != b'}' {
+        return None;
+    }
+    buf.depth -= 1;
+    buf.offset += 1;
+    Some(items)
+}
diff --git a/src/print.rs b/src/print.rs
new file mode 100644
index 0000000..3d502ec
--- /dev/null
+++ b/src/print.rs
@@ -0,0 +1,163 @@
+use crate::number::format_number;
+use crate::value::{c_bytes, Json, Value, NESTING_LIMIT};
+
+pub fn print(item: &Json) -> Option<String> {
+    render(item, true)
+}
+
+pub fn print_unformatted(item: &Json) -> Option<String> {
+    render(item, false)
+}
+
+pub fn print_buffered(item: &Json, prebuffer: i32, format: bool) -> Option<String> {
+    if prebuffer < 0 {
+        return None;
+    }
+    render(item, format)
+}
+
+pub fn print_preallocated(item: &Json, buffer: &mut [u8], format: bool) -> bool {
+    let Some(text) = render(item, format) else {
+        return false;
+    };
+    let bytes = text.as_bytes();
+    if bytes.len() + 1 > buffer.len() {
+        return false;
+    }
+    buffer[..bytes.len()].copy_from_slice(bytes);
+    buffer[bytes.len()] = 0;
+    true
+}
+
+fn render(item: &Json, format: bool) -> Option<String> {
+    let mut out = Vec::new();
+    if !print_value(item, &mut out, format, 0) {
+        return None;
+    }
+    String::from_utf8(out).ok()
+}
+
+fn print_value(item: &Json, out: &mut Vec<u8>, format: bool, depth: usize) -> bool {
+    match &item.value {
+        Value::Null => {
+            out.extend_from_slice(b"null");
+            true
+        }
+        Value::Bool(false) => {
+            out.extend_from_slice(b"false");
+            true
+        }
+        Value::Bool(true) => {
+            out.extend_from_slice(b"true");
+            true
+        }
+        Value::Number {
+            valuedouble,
+            valueint,
+        } => match format_number(*valuedouble, *valueint) {
+            Some(text) => {
+                out.extend_from_slice(text.as_bytes());
+                true
+            }
+            None => false,
+        },
+        Value::Raw(text) => {
+            out.extend_from_slice(c_bytes(text));
+            true
+        }
+        Value::String(text) => {
+            print_string(out, text);
+            true
+        }
+        Value::Array(items) => print_array(items, out, format, depth),
+        Value::Object(items) => print_object(items, out, format, depth),
+    }
+}
+
+fn print_string(out: &mut Vec<u8>, text: &str) {
+    let input = c_bytes(text);
+    out.push(b'"');
+    for byte in input {
+        if *byte > 31 && *byte != b'"' && *byte != b'\\' {
+            out.push(*byte);
+            continue;
+        }
+        out.push(b'\\');
+        match *byte {
+            b'\\' => out.push(b'\\'),
+            b'"' => out.push(b'"'),
+            8 => out.push(b'b'),
+            12 => out.push(b'f'),
+            b'\n' => out.push(b'n'),
+            b'\r' => out.push(b'r'),
+            b'\t' => out.push(b't'),
+            other => {
+                let escaped = format!("u{other:04x}");
+                out.extend_from_slice(escaped.as_bytes());
+            }
+        }
+    }
+    out.push(b'"');
+}
+
+fn print_array(items: &[Json], out: &mut Vec<u8>, format: bool, depth: usize) -> bool {
+    if depth >= NESTING_LIMIT {
+        return false;
+    }
+    let depth = depth + 1;
+    out.push(b'[');
+    for (index, child) in items.iter().enumerate() {
+        if !print_value(child, out, format, depth) {
+            return false;
+        }
+        if index + 1 != items.len() {
+            out.push(b',');
+            if format {
+                out.push(b' ');
+            }
+        }
+    }
+    out.push(b']');
+    true
+}
+
+fn print_object(items: &[Json], out: &mut Vec<u8>, format: bool, depth: usize) -> bool {
+    if depth >= NESTING_LIMIT {
+        return false;
+    }
+    let depth = depth + 1;
+    out.push(b'{');
+    if format {
+        out.push(b'\n');
+    }
+    for (index, child) in items.iter().enumerate() {
+        if format {
+            out.resize(out.len() + depth, b'\t');
+        }
+        let name = child
+            .key
+            .as_ref()
+            .map(|key| key.name.as_str())
+            .unwrap_or("");
+        print_string(out, name);
+        out.push(b':');
+        if format {
+            out.push(b'\t');
+        }
+        if !print_value(child, out, format, depth) {
+            return false;
+        }
+        if index + 1 != items.len() {
+            out.push(b',');
+        }
+        if format {
+            out.push(b'\n');
+        }
+    }
+    if format {
+        let tabs = depth.saturating_sub(1);
+        out.resize(out.len() + tabs, b'\t');
+    }
+    out.push(b'}');
+    true
+}
diff --git a/src/value.rs b/src/value.rs
new file mode 100644
index 0000000..0cca88b
--- /dev/null
+++ b/src/value.rs
@@ -0,0 +1,731 @@
+use crate::number::{compare_double, value_int};
+
+pub const NESTING_LIMIT: usize = 1000;
+pub const CIRCULAR_LIMIT: usize = 10000;
+
+pub const TYPE_INVALID: i32 = 0;
+pub const TYPE_FALSE: i32 = 1 << 0;
+pub const TYPE_TRUE: i32 = 1 << 1;
+pub const TYPE_NULL: i32 = 1 << 2;
+pub const TYPE_NUMBER: i32 = 1 << 3;
+pub const TYPE_STRING: i32 = 1 << 4;
+pub const TYPE_ARRAY: i32 = 1 << 5;
+pub const TYPE_OBJECT: i32 = 1 << 6;
+pub const TYPE_RAW: i32 = 1 << 7;
+pub const TYPE_IS_REFERENCE: i32 = 256;
+pub const TYPE_STRING_IS_CONST: i32 = 512;
+
+#[derive(Clone, Debug)]
+pub struct Json {
+    pub(crate) value: Value,
+    pub(crate) key: Option<Key>,
+    pub(crate) reference: bool,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Key {
+    pub(crate) name: String,
+    pub(crate) constant: bool,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) enum Value {
+    Bool(bool),
+    Null,
+    Number { valuedouble: f64, valueint: i32 },
+    String(String),
+    Raw(String),
+    Array(Vec<Json>),
+    Object(Vec<Json>),
+}
+
+pub fn c_bytes(text: &str) -> &[u8] {
+    match text.as_bytes().iter().position(|byte| *byte == 0) {
+        Some(index) => &text.as_bytes()[..index],
+        None => text.as_bytes(),
+    }
+}
+
+pub fn c_prefix(text: &str) -> &str {
+    let bytes = c_bytes(text);
+    std::str::from_utf8(bytes).unwrap_or("")
+}
+
+fn blank(value: Value) -> Json {
+    Json {
+        value,
+        key: None,
+        reference: false,
+    }
+}
+
+pub fn version() -> &'static str {
+    "1.7.19"
+}
+
+pub fn type_bits(item: &Json) -> i32 {
+    let mut bits = match item.value {
+        Value::Bool(false) => TYPE_FALSE,
+        Value::Bool(true) => TYPE_TRUE,
+        Value::Null => TYPE_NULL,
+        Value::Number { .. } => TYPE_NUMBER,
+        Value::String(_) => TYPE_STRING,
+        Value::Raw(_) => TYPE_RAW,
+        Value::Array(_) => TYPE_ARRAY,
+        Value::Object(_) => TYPE_OBJECT,
+    };
+    if item.reference {
+        bits |= TYPE_IS_REFERENCE;
+    }
+    if item.key.as_ref().is_some_and(|key| key.constant) {
+        bits |= TYPE_STRING_IS_CONST;
+    }
+    bits
+}
+
+pub fn delete(item: Json) {
+    drop(item);
+}
+
+pub fn key(item: &Json) -> Option<&str> {
+    item.key.as_ref().map(|key| c_prefix(&key.name))
+}
+
+pub fn is_reference(item: &Json) -> bool {
+    item.reference
+}
+
+pub fn string_is_const(item: &Json) -> bool {
+    item.key.as_ref().is_some_and(|key| key.constant)
+}
+
+pub fn is_invalid(_item: &Json) -> bool {
+    false
+}
+
+pub fn is_false(item: &Json) -> bool {
+    matches!(item.value, Value::Bool(false))
+}
+
+pub fn is_true(item: &Json) -> bool {
+    matches!(item.value, Value::Bool(true))
+}
+
+pub fn is_bool(item: &Json) -> bool {
+    matches!(item.value, Value::Bool(_))
+}
+
+pub fn is_null(item: &Json) -> bool {
+    matches!(item.value, Value::Null)
+}
+
+pub fn is_number(item: &Json) -> bool {
+    matches!(item.value, Value::Number { .. })
+}
+
+pub fn is_string(item: &Json) -> bool {
+    matches!(item.value, Value::String(_))
+}
+
+pub fn is_array(item: &Json) -> bool {
+    matches!(item.value, Value::Array(_))
+}
+
+pub fn is_object(item: &Json) -> bool {
+    matches!(item.value, Value::Object(_))
+}
+
+pub fn is_raw(item: &Json) -> bool {
+    matches!(item.value, Value::Raw(_))
+}
+
+pub fn get_string_value(item: &Json) -> Option<&str> {
+    match &item.value {
+        Value::String(text) => Some(c_prefix(text)),
+        _ => None,
+    }
+}
+
+pub fn get_number_value(item: &Json) -> f64 {
+    match item.value {
+        Value::Number { valuedouble, .. } => valuedouble,
+        _ => f64::NAN,
+    }
+}
+
+pub fn create_null() -> Json {
+    blank(Value::Null)
+}
+
+pub fn create_true() -> Json {
+    blank(Value::Bool(true))
+}
+
+pub fn create_false() -> Json {
+    blank(Value::Bool(false))
+}
+
+pub fn create_bool(value: bool) -> Json {
+    blank(Value::Bool(value))
+}
+
+pub fn create_number(number: f64) -> Json {
+    blank(Value::Number {
+        valuedouble: number,
+        valueint: value_int(number),
+    })
+}
+
+pub fn create_string(string: &str) -> Json {
+    blank(Value::String(string.to_owned()))
+}
+
+pub fn create_raw(raw: &str) -> Json {
+    blank(Value::Raw(raw.to_owned()))
+}
+
+pub fn create_array() -> Json {
+    blank(Value::Array(Vec::new()))
+}
+
+pub fn create_object() -> Json {
+    blank(Value::Object(Vec::new()))
+}
+
+pub fn create_string_reference(string: &str) -> Json {
+    let mut item = create_string(string);
+    item.reference = true;
+    item
+}
+
+pub fn create_array_reference(children: &[Json]) -> Json {
+    let mut item = blank(Value::Array(children.to_vec()));
+    item.reference = true;
+    item
+}
+
+pub fn create_object_reference(children: &[Json]) -> Json {
+    let mut item = blank(Value::Object(children.to_vec()));
+    item.reference = true;
+    item
+}
+
+pub fn create_int_array(numbers: &[i32]) -> Json {
+    let items = numbers
+        .iter()
+        .copied()
+        .map(|number| create_number(f64::from(number)))
+        .collect();
+    blank(Value::Array(items))
+}
+
+pub fn create_float_array(numbers: &[f32]) -> Json {
+    let items = numbers
+        .iter()
+        .copied()
+        .map(|number| create_number(f64::from(number)))
+        .collect();
+    blank(Value::Array(items))
+}
+
+pub fn create_double_array(numbers: &[f64]) -> Json {
+    let items = numbers.iter().copied().map(create_number).collect();
+    blank(Value::Array(items))
+}
+
+pub fn create_string_array(strings: &[&str]) -> Json {
+    let items = strings.iter().copied().map(create_string).collect();
+    blank(Value::Array(items))
+}
+
+fn children(item: &Json) -> &[Json] {
+    match &item.value {
+        Value::Array(items) | Value::Object(items) => items,
+        _ => &[],
+    }
+}
+
+fn children_mut(item: &mut Json) -> Option<&mut Vec<Json>> {
+    match &mut item.value {
+        Value::Array(items) | Value::Object(items) => Some(items),
+        _ => None,
+    }
+}
+
+pub fn get_array_size(array: &Json) -> i32 {
+    children(array).len() as i32
+}
+
+pub fn get_array_item(array: &Json, index: i32) -> Option<&Json> {
+    if index < 0 {
+        return None;
+    }
+    children(array).get(index as usize)
+}
+
+pub fn get_array_item_mut(array: &mut Json, index: i32) -> Option<&mut Json> {
+    if index < 0 {
+        return None;
+    }
+    let index = index as usize;
+    children_mut(array)?.get_mut(index)
+}
+
+fn key_eq(left: &str, right: &str, case_sensitive: bool) -> bool {
+    if case_sensitive {
+        c_bytes(left) == c_bytes(right)
+    } else {
+        case_insensitive_eq(c_bytes(left), c_bytes(right))
+    }
+}
+
+fn case_insensitive_eq(left: &[u8], right: &[u8]) -> bool {
+    let mut index = 0;
+    loop {
+        let a = left.get(index).copied().unwrap_or(0);
+        let b = right.get(index).copied().unwrap_or(0);
+        if a.to_ascii_lowercase() != b.to_ascii_lowercase() {
+            return false;
+        }
+        if a == 0 {
+            return true;
+        }
+        index += 1;
+    }
+}
+
+fn find_child(items: &[Json], name: &str, case_sensitive: bool) -> Option<usize> {
+    for (index, child) in items.iter().enumerate() {
+        let Some(key) = child.key.as_ref() else {
+            if case_sensitive {
+                return None;
+            }
+            continue;
+        };
+        if key_eq(&key.name, name, case_sensitive) {
+            return Some(index);
+        }
+    }
+    None
+}
+
+pub fn get_object_item<'a>(object: &'a Json, name: &str) -> Option<&'a Json> {
+    get_object_item_inner(object, name, false)
+}
+
+pub fn get_object_item_case_sensitive<'a>(object: &'a Json, name: &str) -> Option<&'a Json> {
+    get_object_item_inner(object, name, true)
+}
+
+fn get_object_item_inner<'a>(
+    object: &'a Json,
+    name: &str,
+    case_sensitive: bool,
+) -> Option<&'a Json> {
+    let items = match &object.value {
+        Value::Object(items) | Value::Array(items) => items,
+        _ => return None,
+    };
+    let index = find_child(items, name, case_sensitive)?;
+    items.get(index)
+}
+
+pub fn get_object_item_mut<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    get_object_item_mut_inner(object, name, false)
+}
+
+pub fn get_object_item_case_sensitive_mut<'a>(
+    object: &'a mut Json,
+    name: &str,
+) -> Option<&'a mut Json> {
+    get_object_item_mut_inner(object, name, true)
+}
+
+fn get_object_item_mut_inner<'a>(
+    object: &'a mut Json,
+    name: &str,
+    case_sensitive: bool,
+) -> Option<&'a mut Json> {
+    let items = match &mut object.value {
+        Value::Object(items) | Value::Array(items) => items,
+        _ => return None,
+    };
+    let index = find_child(items, name, case_sensitive)?;
+    items.get_mut(index)
+}
+
+pub fn has_object_item(object: &Json, name: &str) -> bool {
+    get_object_item(object, name).is_some()
+}
+
+pub fn array_for_each(item: &Json) -> impl Iterator<Item = &Json> {
+    children(item).iter()
+}
+
+pub fn add_item_to_array(array: &mut Json, item: Json) -> bool {
+    let Value::Array(items) = &mut array.value else {
+        return false;
+    };
+    items.push(item);
+    true
+}
+
+pub fn add_item_to_object(object: &mut Json, name: &str, item: Json) -> bool {
+    push_object_item(object, name, item, false)
+}
+
+pub fn add_item_to_object_cs(object: &mut Json, name: &str, item: Json) -> bool {
+    push_object_item(object, name, item, true)
+}
+
+fn push_object_item(object: &mut Json, name: &str, mut item: Json, constant_key: bool) -> bool {
+    let Value::Object(items) = &mut object.value else {
+        return false;
+    };
+    item.key = Some(Key {
+        name: name.to_owned(),
+        constant: constant_key,
+    });
+    items.push(item);
+    true
+}
+
+fn object_items_mut(object: &mut Json) -> Option<&mut Vec<Json>> {
+    match &mut object.value {
+        Value::Object(items) => Some(items),
+        _ => None,
+    }
+}
+
+pub fn add_item_reference_to_array(array: &mut Json, item: &Json) -> bool {
+    let mut copy = item.clone();
+    copy.key = None;
+    copy.reference = true;
+    add_item_to_array(array, copy)
+}
+
+pub fn add_item_reference_to_object(object: &mut Json, name: &str, item: &Json) -> bool {
+    let mut copy = item.clone();
+    copy.key = None;
+    copy.reference = true;
+    add_item_to_object(object, name, copy)
+}
+
+fn push_named(object: &mut Json, name: &str, item: Json) -> Option<usize> {
+    if !add_item_to_object(object, name, item) {
+        return None;
+    }
+    let len = object_items_mut(object)?.len();
+    Some(len - 1)
+}
+
+pub fn add_null_to_object<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_null())?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_true_to_object<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_true())?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_false_to_object<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_false())?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_bool_to_object<'a>(
+    object: &'a mut Json,
+    name: &str,
+    value: bool,
+) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_bool(value))?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_number_to_object<'a>(
+    object: &'a mut Json,
+    name: &str,
+    number: f64,
+) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_number(number))?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_string_to_object<'a>(
+    object: &'a mut Json,
+    name: &str,
+    string: &str,
+) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_string(string))?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_raw_to_object<'a>(object: &'a mut Json, name: &str, raw: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_raw(raw))?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_object_to_object<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_object())?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn add_array_to_object<'a>(object: &'a mut Json, name: &str) -> Option<&'a mut Json> {
+    let index = push_named(object, name, create_array())?;
+    object_items_mut(object)?.get_mut(index)
+}
+
+pub fn detach_item_from_array(array: &mut Json, which: i32) -> Option<Json> {
+    if which < 0 {
+        return None;
+    }
+    let items = children_mut(array)?;
+    let index = which as usize;
+    if index >= items.len() {
+        return None;
+    }
+    Some(items.remove(index))
+}
+
+pub fn delete_item_from_array(array: &mut Json, which: i32) {
+    if let Some(item) = detach_item_from_array(array, which) {
+        delete(item);
+    }
+}
+
+pub fn detach_item_from_object(object: &mut Json, name: &str) -> Option<Json> {
+    detach_item_from_object_inner(object, name, false)
+}
+
+pub fn detach_item_from_object_case_sensitive(object: &mut Json, name: &str) -> Option<Json> {
+    detach_item_from_object_inner(object, name, true)
+}
+
+fn detach_item_from_object_inner(
+    object: &mut Json,
+    name: &str,
+    case_sensitive: bool,
+) -> Option<Json> {
+    let items = match &mut object.value {
+        Value::Object(items) => items,
+        _ => return None,
+    };
+    let index = find_child(items, name, case_sensitive)?;
+    Some(items.remove(index))
+}
+
+pub fn delete_item_from_object(object: &mut Json, name: &str) {
+    if let Some(item) = detach_item_from_object(object, name) {
+        delete(item);
+    }
+}
+
+pub fn delete_item_from_object_case_sensitive(object: &mut Json, name: &str) {
+    if let Some(item) = detach_item_from_object_case_sensitive(object, name) {
+        delete(item);
+    }
+}
+
+pub fn insert_item_in_array(array: &mut Json, which: i32, item: Json) -> bool {
+    if which < 0 {
+        return false;
+    }
+    let Value::Array(items) = &mut array.value else {
+        return false;
+    };
+    let index = which as usize;
+    if index >= items.len() {
+        items.push(item);
+    } else {
+        items.insert(index, item);
+    }
+    true
+}
+
+pub fn replace_item_in_array(array: &mut Json, which: i32, newitem: Json) -> bool {
+    if which < 0 {
+        return false;
+    }
+    let Value::Array(items) = &mut array.value else {
+        return false;
+    };
+    let index = which as usize;
+    if index >= items.len() {
+        return false;
+    }
+    items[index] = newitem;
+    true
+}
+
+pub fn replace_item_in_object(object: &mut Json, name: &str, newitem: Json) -> bool {
+    replace_item_in_object_inner(object, name, newitem, false)
+}
+
+pub fn replace_item_in_object_case_sensitive(object: &mut Json, name: &str, newitem: Json) -> bool {
+    replace_item_in_object_inner(object, name, newitem, true)
+}
+
+fn replace_item_in_object_inner(
+    object: &mut Json,
+    name: &str,
+    mut newitem: Json,
+    case_sensitive: bool,
+) -> bool {
+    newitem.key = Some(Key {
+        name: name.to_owned(),
+        constant: false,
+    });
+    let Value::Object(items) = &mut object.value else {
+        return false;
+    };
+    let Some(index) = find_child(items, name, case_sensitive) else {
+        return false;
+    };
+    items[index] = newitem;
+    true
+}
+
+pub fn duplicate(item: &Json, recurse: bool) -> Option<Json> {
+    duplicate_rec(item, 0, recurse)
+}
+
+fn duplicate_rec(item: &Json, depth: usize, recurse: bool) -> Option<Json> {
+    if depth >= CIRCULAR_LIMIT {
+        return None;
+    }
+    let value = match &item.value {
+        Value::Array(items) if recurse => Value::Array(duplicate_list(items, depth)?),
+        Value::Object(items) if recurse => Value::Object(duplicate_list(items, depth)?),
+        Value::Array(_) => Value::Array(Vec::new()),
+        Value::Object(_) => Value::Object(Vec::new()),
+        Value::Bool(value) => Value::Bool(*value),
+        Value::Null => Value::Null,
+        Value::Number {
+            valuedouble,
+            valueint,
+        } => Value::Number {
+            valuedouble: *valuedouble,
+            valueint: *valueint,
+        },
+        Value::String(text) => Value::String(text.clone()),
+        Value::Raw(text) => Value::Raw(text.clone()),
+    };
+    Some(Json {
+        value,
+        key: item.key.clone(),
+        reference: false,
+    })
+}
+
+fn duplicate_list(items: &[Json], depth: usize) -> Option<Vec<Json>> {
+    let mut out = Vec::with_capacity(items.len());
+    for item in items {
+        out.push(duplicate_rec(item, depth + 1, true)?);
+    }
+    Some(out)
+}
+
+pub fn compare(a: &Json, b: &Json, case_sensitive: bool) -> bool {
+    if std::ptr::eq(a, b) {
+        return true;
+    }
+    if std::mem::discriminant(&a.value) != std::mem::discriminant(&b.value) {
+        return false;
+    }
+    match (&a.value, &b.value) {
+        (Value::Bool(left), Value::Bool(right)) => left == right,
+        (Value::Null, Value::Null) => true,
+        (
+            Value::Number {
+                valuedouble: left, ..
+            },
+            Value::Number {
+                valuedouble: right, ..
+            },
+        ) => compare_double(*left, *right),
+        (Value::String(left), Value::String(right)) | (Value::Raw(left), Value::Raw(right)) => {
+            c_bytes(left) == c_bytes(right)
+        }
+        (Value::Array(left), Value::Array(right)) => {
+            left.len() == right.len()
+                && left
+                    .iter()
+                    .zip(right.iter())
+                    .all(|(a_item, b_item)| compare(a_item, b_item, case_sensitive))
+        }
+        (Value::Object(left), Value::Object(right)) => {
+            left.iter()
+                .all(|a_item| object_pair_eq(a_item, right, case_sensitive))
+                && right
+                    .iter()
+                    .all(|b_item| object_pair_eq(b_item, left, case_sensitive))
+        }
+        _ => false,
+    }
+}
+
+fn object_pair_eq(item: &Json, others: &[Json], case_sensitive: bool) -> bool {
+    let Some(name) = item.key.as_ref() else {
+        return false;
+    };
+    let Some(index) = find_child(others, &name.name, case_sensitive) else {
+        return false;
+    };
+    compare(item, &others[index], case_sensitive)
+}
+
+pub fn set_number_helper(object: &mut Json, number: f64) -> f64 {
+    if let Value::Number {
+        valuedouble,
+        valueint,
+    } = &mut object.value
+    {
+        *valueint = value_int(number);
+        *valuedouble = number;
+        number
+    } else {
+        f64::NAN
+    }
+}
+
+pub fn set_int_value(object: &mut Json, number: i32) -> i32 {
+    if let Value::Number {
+        valuedouble,
+        valueint,
+    } = &mut object.value
+    {
+        *valueint = number;
+        *valuedouble = f64::from(number);
+    }
+    number
+}
+
+pub fn set_number_value(object: &mut Json, number: f64) -> f64 {
+    set_number_helper(object, number)
+}
+
+pub fn set_valuestring<'a>(object: &'a mut Json, valuestring: &str) -> Option<&'a str> {
+    if object.reference {
+        return None;
+    }
+    match &mut object.value {
+        Value::String(text) => {
+            *text = valuestring.to_owned();
+            Some(c_prefix(text))
+        }
+        _ => None,
+    }
+}
+
+pub fn set_bool_value(object: &mut Json, bool_value: bool) -> i32 {
+    if !matches!(object.value, Value::Bool(_)) {
+        return TYPE_INVALID;
+    }
+    object.value = Value::Bool(bool_value);
+    if bool_value {
+        TYPE_TRUE
+    } else {
+        TYPE_FALSE
+    }
+}
diff --git a/tests/public_api.rs b/tests/public_api.rs
new file mode 100644
index 0000000..c9727ee
--- /dev/null
+++ b/tests/public_api.rs
@@ -0,0 +1,258 @@
+use cjson::{
+    add_item_reference_to_array, add_item_to_object_cs, add_number_to_object, add_string_to_object,
+    compare, create_array, create_false, create_null, create_number, create_object, create_string,
+    create_true, delete, delete_item_from_array, detach_item_from_object, duplicate,
+    get_array_item, get_array_item_mut, get_array_size, get_error_ptr, get_number_value,
+    get_object_item, get_object_item_case_sensitive, get_string_value, has_object_item,
+    insert_item_in_array, is_array, is_bool, is_false, is_null, is_number, is_object, is_reference,
+    is_string, is_true, key, minify, parse, parse_with_opts, print, print_buffered,
+    print_preallocated, print_unformatted, replace_item_in_array, set_bool_value, set_number_value,
+    set_valuestring, string_is_const, type_bits, version, TYPE_FALSE, TYPE_INVALID, TYPE_NUMBER,
+};
+
+#[test]
+fn version_is_the_vendored_release() {
+    assert_eq!(version(), "1.7.19");
+}
+
+#[test]
+fn parse_prints_scalars() {
+    assert_eq!(
+        print_unformatted(&parse("null").unwrap()).as_deref(),
+        Some("null")
+    );
+    assert_eq!(
+        print_unformatted(&parse("true").unwrap()).as_deref(),
+        Some("true")
+    );
+    assert_eq!(
+        print_unformatted(&parse("false").unwrap()).as_deref(),
+        Some("false")
+    );
+    assert_eq!(
+        print_unformatted(&parse("0").unwrap()).as_deref(),
+        Some("0")
+    );
+    assert_eq!(
+        print_unformatted(&parse("-2").unwrap()).as_deref(),
+        Some("-2")
+    );
+    assert_eq!(
+        print_unformatted(&parse("1.0").unwrap()).as_deref(),
+        Some("1")
+    );
+    assert_eq!(
+        print_unformatted(&parse("0.1").unwrap()).as_deref(),
+        Some("0.1")
+    );
+}
+
+#[test]
+fn parse_prints_string_array_and_object() {
+    let text = "  { \"a\" : [1, true, null, \"x\"] }  ";
+    let value = parse(text).unwrap();
+    assert_eq!(
+        print_unformatted(&value).as_deref(),
+        Some("{\"a\":[1,true,null,\"x\"]}")
+    );
+    assert!(is_object(&value));
+    let array = get_object_item(&value, "A").unwrap();
+    assert!(is_array(array));
+    assert_eq!(get_array_size(array), 4);
+    assert!(is_number(get_array_item(array, 0).unwrap()));
+    assert!(is_true(get_array_item(array, 1).unwrap()));
+    assert!(is_null(get_array_item(array, 2).unwrap()));
+    assert_eq!(
+        get_string_value(get_array_item(array, 3).unwrap()),
+        Some("x")
+    );
+    assert!(get_object_item_case_sensitive(&value, "A").is_none());
+    assert!(has_object_item(&value, "a"));
+}
+
+#[test]
+fn escaped_string_round_trip() {
+    let value = parse(r#""a\"b\\c\/d\n\t""#).unwrap();
+    assert_eq!(get_string_value(&value), Some("a\"b\\c/d\n\t"));
+    assert_eq!(
+        print_unformatted(&value).as_deref(),
+        Some(r#""a\"b\\c/d\n\t""#)
+    );
+}
+
+#[test]
+fn unicode_escape_prints_utf8() {
+    let value = parse(r#""\u0041\u00e9""#).unwrap();
+    assert_eq!(get_string_value(&value), Some("Aé"));
+    assert_eq!(print_unformatted(&value).as_deref(), Some("\"Aé\""));
+}
+
+#[test]
+fn reject_truncated_container_without_panic() {
+    assert!(parse("[").is_none());
+    assert!(get_error_ptr().is_some());
+    assert!(parse("{").is_none());
+    assert!(parse("\"unterminated").is_none());
+    assert!(parse("").is_none());
+}
+
+#[test]
+fn require_null_terminated_rejects_trailing_junk() {
+    let ok = parse_with_opts("null", false);
+    assert!(ok.item.is_some());
+    assert!(is_null(ok.item.as_ref().unwrap()));
+    let bad = parse_with_opts("null x", true);
+    assert!(bad.item.is_none());
+}
+
+#[test]
+fn builders_match_print() {
+    let mut object = create_object();
+    add_number_to_object(&mut object, "n", 1.0);
+    add_string_to_object(&mut object, "s", "hi");
+    assert_eq!(
+        print_unformatted(&object).as_deref(),
+        Some("{\"n\":1,\"s\":\"hi\"}")
+    );
+    assert_eq!(key(get_object_item(&object, "n").unwrap()), Some("n"));
+    assert_eq!(
+        type_bits(get_object_item(&object, "n").unwrap()) & TYPE_NUMBER,
+        TYPE_NUMBER
+    );
+}
+
+#[test]
+fn array_insert_replace_and_delete() {
+    let mut array = parse("[1,3]").unwrap();
+    assert!(insert_item_in_array(&mut array, 1, create_number(2.0)));
+    assert_eq!(print_unformatted(&array).as_deref(), Some("[1,2,3]"));
+    assert!(replace_item_in_array(&mut array, 0, create_false()));
+    assert!(is_false(get_array_item(&array, 0).unwrap()));
+    delete_item_from_array(&mut array, 0);
+    assert_eq!(print_unformatted(&array).as_deref(), Some("[2,3]"));
+    delete(array);
+}
+
+#[test]
+fn detach_object_item_keeps_the_rest() {
+    let mut object = parse("{\"a\":1,\"b\":2}").unwrap();
+    let detached = detach_item_from_object(&mut object, "A").unwrap();
+    assert_eq!(get_number_value(&detached), 1.0);
+    assert_eq!(print_unformatted(&object).as_deref(), Some("{\"b\":2}"));
+}
+
+#[test]
+fn duplicate_and_compare() {
+    let original = parse("{\"A\":[1,true]}").unwrap();
+    let shallow = duplicate(&original, false).unwrap();
+    assert_eq!(print_unformatted(&shallow).as_deref(), Some("{}"));
+    let deep = duplicate(&original, true).unwrap();
+    assert_eq!(
+        print_unformatted(&deep).as_deref(),
+        Some("{\"A\":[1,true]}")
+    );
+    let other_case = parse("{\"a\":[1,true]}").unwrap();
+    assert!(compare(&deep, &other_case, false));
+    assert!(!compare(&deep, &other_case, true));
+    assert!(compare(&deep, &deep, true));
+}
+
+#[test]
+fn set_helpers_change_printed_value() {
+    let mut number = create_number(1.0);
+    assert_eq!(set_number_value(&mut number, 2.5), 2.5);
+    assert_eq!(print_unformatted(&number).as_deref(), Some("2.5"));
+    let mut flag = create_true();
+    assert!(is_bool(&flag) && is_true(&flag));
+    assert_eq!(set_bool_value(&mut flag, false), TYPE_FALSE);
+    assert!(is_false(&flag));
+    let mut untouched = create_null();
+    assert_eq!(set_bool_value(&mut untouched, true), TYPE_INVALID);
+    assert!(is_null(&untouched));
+    let mut text = create_string("ab");
+    assert_eq!(set_valuestring(&mut text, "z"), Some("z"));
+    assert_eq!(print_unformatted(&text).as_deref(), Some("\"z\""));
+    assert!(set_valuestring(&mut number, "nope").is_none());
+}
+
+#[test]
+fn formatted_object_uses_tabs() {
+    let value = parse("{\"a\":1}").unwrap();
+    assert_eq!(print(&value).as_deref(), Some("{\n\t\"a\":\t1\n}"));
+}
+
+#[test]
+fn minify_drops_space_and_comments_and_keeps_strings() {
+    let mut spaced = "{ \"a\" : 1 }".to_string();
+    minify(&mut spaced);
+    assert_eq!(spaced, "{\"a\":1}");
+
+    let mut commented = "{ \"a\" : 1 } // hi\n/* x */".to_string();
+    minify(&mut commented);
+    assert_eq!(commented, "{\"a\":1}");
+
+    let mut sentence = "{\"a\":\"b c\"}".to_string();
+    minify(&mut sentence);
+    assert_eq!(sentence, "{\"a\":\"b c\"}");
+
+    let mut quoted = "{\"a\":\"say \\\"hi\\\"\"}".to_string();
+    minify(&mut quoted);
+    assert_eq!(quoted, "{\"a\":\"say \\\"hi\\\"\"}");
+
+    let mut slash = "{\"a\":1}/".to_string();
+    minify(&mut slash);
+    assert_eq!(slash, "{\"a\":1}");
+}
+
+#[test]
+fn print_buffer_helpers() {
+    let value = parse("[1,2]").unwrap();
+    assert!(print_buffered(&value, -1, false).is_none());
+    assert_eq!(print_buffered(&value, 8, false).as_deref(), Some("[1,2]"));
+    let mut buffer = [0u8; 8];
+    assert!(print_preallocated(&value, &mut buffer, false));
+    assert_eq!(&buffer[..6], b"[1,2]\0");
+    let mut tiny = [0u8; 2];
+    assert!(!print_preallocated(&value, &mut tiny, false));
+}
+
+#[test]
+fn create_array_from_numbers() {
+    let array = cjson::create_int_array(&[1, -2, 3]);
+    assert_eq!(print_unformatted(&array).as_deref(), Some("[1,-2,3]"));
+    let strings = cjson::create_string_array(&["a", "b"]);
+    assert_eq!(
+        print_unformatted(&strings).as_deref(),
+        Some("[\"a\",\"b\"]")
+    );
+    assert!(is_string(get_array_item(&strings, 1).unwrap()));
+}
+
+#[test]
+fn string_reference_refuses_set_and_still_prints() {
+    let source = create_string("ref");
+    let mut array = create_array();
+    assert!(add_item_reference_to_array(&mut array, &source));
+    assert_eq!(print_unformatted(&array).as_deref(), Some("[\"ref\"]"));
+    let child = get_array_item_mut(&mut array, 0).unwrap();
+    assert!(is_reference(child));
+    assert!(set_valuestring(child, "x").is_none());
+    assert_eq!(print_unformatted(&array).as_deref(), Some("[\"ref\"]"));
+    assert_eq!(print_unformatted(&source).as_deref(), Some("\"ref\""));
+}
+
+#[test]
+fn const_key_flag_is_visible() {
+    let mut object = create_object();
+    assert!(add_item_to_object_cs(&mut object, "k", create_true()));
+    assert!(string_is_const(get_object_item(&object, "k").unwrap()));
+    assert_eq!(print_unformatted(&object).as_deref(), Some("{\"k\":true}"));
+}
+
+#[test]
+fn non_number_get_is_nan_and_missing_index_is_absent() {
+    assert!(get_number_value(&create_array()).is_nan());
+    assert!(get_string_value(&create_true()).is_none());
+    assert!(get_array_item(&create_array(), -1).is_none());
+    assert_eq!(get_array_size(&create_null()), 0);
+}
