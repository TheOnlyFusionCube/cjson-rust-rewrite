diff --git a/differential/oracle.c b/differential/oracle.c
new file mode 100644
index 0000000..f819859
--- /dev/null
+++ b/differential/oracle.c
@@ -0,0 +1,53 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cJSON.h"
+
+int main(void)
+{
+    size_t length = 0;
+    size_t capacity = 4096;
+    char *buffer = (char *)malloc(capacity);
+    if (buffer == NULL)
+    {
+        return 1;
+    }
+
+    int byte = 0;
+    while ((byte = fgetc(stdin)) != EOF)
+    {
+        if (length + 2 > capacity)
+        {
+            size_t next = capacity * 2;
+            char *grown = (char *)realloc(buffer, next);
+            if (grown == NULL)
+            {
+                free(buffer);
+                return 1;
+            }
+            buffer = grown;
+            capacity = next;
+        }
+        buffer[length++] = (char)byte;
+    }
+    buffer[length] = '\0';
+
+    cJSON *item = cJSON_Parse(buffer);
+    if (item == NULL)
+    {
+        free(buffer);
+        return 2;
+    }
+
+    char *printed = cJSON_PrintUnformatted(item);
+    cJSON_Delete(item);
+    free(buffer);
+    if (printed == NULL)
+    {
+        return 3;
+    }
+    fputs(printed, stdout);
+    cJSON_free(printed);
+    return 0;
+}
diff --git a/differential/run.sh b/differential/run.sh
new file mode 100755
index 0000000..6ebbc9f
--- /dev/null
+++ b/differential/run.sh
@@ -0,0 +1,51 @@
+#!/bin/sh
+set -u
+root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
+cd "$root"
+export LC_ALL=C
+
+echo "canonical form: cJSON_PrintUnformatted bytes. Compact JSON with no space after ':' or ','."
+
+gcc -O2 -std=c11 -o differential/cjson_oracle differential/oracle.c vendor/cJSON/cJSON.c -Ivendor/cJSON -lm
+gcc_ec=$?
+if [ "$gcc_ec" -ne 0 ]; then
+    echo "gcc exit $gcc_ec"
+    exit "$gcc_ec"
+fi
+
+cargo build --bin cjson_print
+cargo_ec=$?
+if [ "$cargo_ec" -ne 0 ]; then
+    echo "cargo build exit $cargo_ec"
+    exit "$cargo_ec"
+fi
+
+pass=0
+fail=0
+panic=0
+for file in differential/fixtures/*.json differential/fixtures/upstream/*.json; do
+    rust_out=$(mktemp)
+    c_out=$(mktemp)
+    ./target/debug/cjson_print < "$file" > "$rust_out"
+    rust_ec=$?
+    ./differential/cjson_oracle < "$file" > "$c_out"
+    c_ec=$?
+    if [ "$rust_ec" -eq 101 ]; then
+        panic=$((panic + 1))
+    fi
+    if [ "$rust_ec" -eq "$c_ec" ] && cmp -s "$rust_out" "$c_out"; then
+        pass=$((pass + 1))
+        printf 'PASS %s\n' "$file"
+    else
+        fail=$((fail + 1))
+        printf 'FAIL %s rust_ec=%s c_ec=%s\n' "$file" "$rust_ec" "$c_ec"
+        diff -u "$c_out" "$rust_out" || true
+    fi
+    rm -f "$rust_out" "$c_out"
+done
+
+printf 'pass=%s fail=%s panic=%s\n' "$pass" "$fail" "$panic"
+if [ "$fail" -ne 0 ] || [ "$panic" -ne 0 ]; then
+    exit 1
+fi
+exit 0
diff --git a/src/bin/cjson_print.rs b/src/bin/cjson_print.rs
new file mode 100644
index 0000000..01fa558
--- /dev/null
+++ b/src/bin/cjson_print.rs
@@ -0,0 +1,19 @@
+use std::io::{self, Read, Write};
+use std::process::exit;
+
+fn main() {
+    let mut input = Vec::new();
+    if io::stdin().read_to_end(&mut input).is_err() {
+        exit(1);
+    }
+    let parsed = cjson::parse_with_length_opts(&input, input.len().saturating_add(1), false);
+    let Some(item) = parsed.item else {
+        exit(2);
+    };
+    let Some(text) = cjson::print_unformatted(&item) else {
+        exit(3);
+    };
+    if io::stdout().write_all(text.as_bytes()).is_err() {
+        exit(1);
+    }
+}
